{
  "version": 1,
  "title": "Obsidian Memory Capture Setup",
  "description": "Configure machine-specific paths used by this skill.",
  "files": [
    {
      "path": "scripts/config.json",
      "format": "json",
      "fields": [
        {
          "key": "vault_root",
          "prompt": "Path to your Obsidian vault root",
          "default": "~/path/to/your/obsidian-vault",
          "required": true
        },
        {
          "key": "sessions_root",
          "prompt": "Path to Codex sessions directory",
          "default": "~/.codex/sessions",
          "required": true
        }
      ]
    }
  ],
  "actions": [
    {
      "id": "install-post-operation-hook",
      "type": "run-script",
      "prompt": "Install and enable Codex post-operation hook for automatic capture?",
      "script": "scripts/install_post_operation_hook.py",
      "args": [
        "--hooks-dir",
        "{{home_dir}}/.codex/hooks",
        "--codex-config",
        "{{home_dir}}/.codex/config.toml"
      ],
      "target_types": [
        "codex-global"
      ],
      "default_enabled": false
    }
  ]
}
